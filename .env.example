# ─── Application ─────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your-256-bit-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Administrador inicial (usado só quando ainda não existe admin) ──
# Deixe ADMIN_PASSWORD vazio para gerar uma senha forte, gravada em
# backend/.admin-initial-password (permissão 600, ignorado pelo git).
ADMIN_EMAIL=admin@curtain.app
ADMIN_PASSWORD=

# ─── Database ─────────────────────────────────────────
DB_PASSWORD=strong_password_here
DATABASE_URL=postgresql://curtain_user:strong_password_here@localhost:5432/curtain_db

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# ─── Storage (S3-compatible) ──────────────────────────
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=curtain-media
AWS_REGION=us-east-1

# ─── Email ────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourcurtain.app

# ─── Frontend ─────────────────────────────────────────
# Deixe vazio: o frontend já chama /api/v1/... e o proxy (nginx/Vite) encaminha.
# Se preencher, use só a origem (ex.: http://localhost:8000), sem /api/v1.
VITE_API_BASE_URL=
VITE_APP_NAME=Curtain

# ── Venda online de ingressos (fase 8) ──────────────────────────────────────
# Desligada por padrão. Só são aceitas credenciais de TESTE do Mercado Pago
# (começam com "TEST-"); uma credencial de produção deixa a venda bloqueada.
PUBLIC_SALES_ENABLED=false
# Endereço do site, para o comprador voltar depois de pagar
PUBLIC_SITE_URL=http://localhost:5173
# Endereço público da API (https) para os avisos de pagamento. Vazio em
# localhost: o pagamento é conferido quando o comprador volta ao site.
PUBLIC_API_URL=
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" das notificações (Webhooks) no painel do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
